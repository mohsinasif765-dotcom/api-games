# Zuvo / Postgres (server only — never expose to the browser)
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@HOST:5432/postgres?sslmode=require
ZUVO_URL=https://PROJECT_REF.supabase.co
ZUVO_ANON_KEY=zu-anon__REPLACE_ME
ZUVO_SERVICE_ROLE_KEY=zu-sk_REPLACE_ME

# Optional admin secret for POST /api/v1/keys
GATEWAY_ADMIN_SECRET=replace-with-long-random-string

# Public (client → our Next.js gateway only)
NEXT_PUBLIC_GAME_API_BASE=/api/v1

# Legacy client (optional; prefer gateway + API key)
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=zu-anon__REPLACE_ME
