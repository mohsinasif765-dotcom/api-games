# Zuvo / Postgres — pooler only (never expose to the browser)
# Transaction pooler (recommended for Vercel serverless):
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@pooler.baas.zuvodev.com:6543/postgres?sslmode=require
# Session pooler (local scripts / longer sessions):
# DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@pooler.baas.zuvodev.com:5432/postgres?sslmode=require

# Zuvo built-in Redis (same host pattern as ludo-shudo-gateway)
# Logical DB 2 = api-games (0=lucky/game, 1=ludo gateway)
REDIS_URL=redis://USER:PASSWORD@HOST:6379
API_GAMES_REDIS_DB=2

ZUVO_URL=https://games.baas.zuvodev.com
ZUVO_ANON_KEY=zu-anon__REPLACE_ME
ZUVO_SERVICE_ROLE_KEY=zu-sk_REPLACE_ME

# Optional admin secret for POST /api/v1/keys
GATEWAY_ADMIN_SECRET=replace-with-long-random-string

# Public game API — browser / WebView → Zuvo Express gateway (not Vercel serverless).
# Local Next fallback: /api/v1
NEXT_PUBLIC_GAME_API_BASE=https://games.app.zuvodev.com/api/v1

# Legacy client (optional; prefer gateway + API key)
NEXT_PUBLIC_SUPABASE_URL=https://games.baas.zuvodev.com
NEXT_PUBLIC_SUPABASE_ANON_KEY=zu-anon__REPLACE_ME
